# ===========================
# Salesforce Configuration
# ===========================
SALESFORCE_CLIENT_ID=your_client_id_here
SALESFORCE_CLIENT_SECRET=your_client_secret_here
SALESFORCE_USERNAME=your_username@company.com
SALESFORCE_PASSWORD=your_password_here
SALESFORCE_SECURITY_TOKEN=your_security_token_here
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com
SALESFORCE_API_VERSION=v60.0

# ===========================
# GitHub Copilot Configuration
# ===========================
GITHUB_COPILOT_API_KEY=your_github_copilot_api_key
GITHUB_COPILOT_MODEL=gpt-4-turbo
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# ===========================
# Database Configuration
# ===========================
DATABASE_URL=postgresql://user:password@localhost:5432/sales_dashboard
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ===========================
# Redis Configuration
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# ===========================
# Flask/Backend Configuration
# ===========================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=app.py
SECRET_KEY=your_secret_key_change_this_in_production
JWT_SECRET_KEY=your_jwt_secret_key_change_this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===========================
# CORS Configuration
# ===========================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ===========================
# MCP Server Configuration
# ===========================
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=3001
MCP_SYNC_INTERVAL=300
MCP_RETRY_ATTEMPTS=3
MCP_RETRY_DELAY=5

# ===========================
# WebSocket Configuration
# ===========================
WEBSOCKET_ENABLED=True
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_RECONNECT_TIMEOUT=5000

# ===========================
# Logging Configuration
# ===========================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ===========================
# API Rate Limiting
# ===========================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=5000

# ===========================
# Data Sync Configuration
# ===========================
SYNC_FULL_SYNC_INTERVAL=86400
SYNC_INCREMENTAL_SYNC_INTERVAL=300
SYNC_BATCH_SIZE=1000
SYNC_TIMEOUT=300

# ===========================
# Analytics Configuration
# ===========================
ANALYTICS_FORECAST_DAYS=90
ANALYTICS_MOVING_AVERAGE_WINDOW=30
ANALYTICS_DEAL_HEALTH_THRESHOLD=50

# ===========================
# Security Configuration
# ===========================
SECURE_COOKIES=False
SECURE_COOKIES_SAMESITE=Lax
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SPECIAL_CHARS=True

# ===========================
# Email Configuration (Optional)
# ===========================
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ===========================
# Feature Flags
# ===========================
FEATURE_COPILOT_ENABLED=True
FEATURE_ADVANCED_ANALYTICS=True
FEATURE_REAL_TIME_SYNC=True
FEATURE_EXPORT_TO_PDF=True
FEATURE_SCHEDULED_REPORTS=True

# ===========================
# Environment
# ===========================
ENVIRONMENT=development
DEBUG=True
ALLOW_DEMO_DATA=True
